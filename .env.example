# Copy to .env and fill in values from Firebase Console → Project settings → Your apps
# https://console.firebase.google.com/

# ------------------------------------------------------------- Churches
# One deployment serves every church; see TENANCY.md. Read by the app and by
# the API routes alike.
#
# The domain churches get a subdomain of. With church.app, uec.church.app is the
# church "uec", and church.app / app.church.app is the platform's front door
# where a congregation asks for a church. Leave empty in development.
VITE_ROOT_DOMAIN=
#
# The church served on an address that names none: localhost, a LAN IP, a
# Vercel preview URL. Empty means those addresses show the platform's front
# door instead. In development, uec.localhost:5173 and app.localhost:5173 pick a
# church or the front door explicitly, whatever this says.
VITE_DEFAULT_CHURCH=
#
# What the platform calls itself until a name is saved in the console
# (Console → Name & front door).
VITE_PLATFORM_NAME=Ekkly

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web Push notifications (FCM). Get from Firebase Console → Project settings
# → Cloud Messaging → Web Push certificates → Generate key pair
VITE_FIREBASE_VAPID_KEY=

# Server-side Firebase Admin access — used by /api/notify to send push, and by
# /api/accounts to read the Firebase Auth user list for the Accounts page.
# Vercel env var only, not used by Vite. Paste the FULL JSON from Firebase
# Console → Project settings → Service accounts → Generate new private key, as
# a single line.
# FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------- Email
# Vercel env vars only, never read by Vite. Used by /api/email to send the
# event digests and the administrator's activity report over Gmail SMTP.
#
# GMAIL_APP_PASSWORD is a 16-character App Password, not the account password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
# GMAIL_USER=church@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Shared secret for the scheduled send. Vercel Cron sends it as
# `Authorization: Bearer <secret>`; without it the GET route stays closed.
# Any long random string will do.
# CRON_SECRET=

# Absolute base URL used for links and images inside the emails, when a church
# has no address of its own to use. With VITE_ROOT_DOMAIN set every church does
# (uec.church.app), and this only matters without it. Falls back to
# VERCEL_PROJECT_PRODUCTION_URL, then to the request host.
# APP_URL=https://uechurch.vercel.app

# IANA timezone for a church whose document names none. Every "today" in a
# digest is resolved in the church's own timezone, because the server's clock
# is UTC. Defaults to Asia/Manila.
# DIGEST_TIMEZONE=Asia/Manila

# ---------------------------------------------------------------- Song search
# Vercel env var only, never read by Vite. Used by /api/youtube-search so the
# song list can search YouTube and add a result without leaving the page.
#
# Google Cloud Console -> create a project -> APIs & Services -> Library ->
# enable "YouTube Data API v3" -> Credentials -> Create credentials -> API key.
# Restrict the key to that one API. The free quota is 10,000 units a day and a
# search costs 100, so roughly a hundred searches a day.
# YOUTUBE_API_KEY=

# Used by the AI features: /api/enhance (writing up minutes), /api/song-lookup
# and /api/lyrics-structure. Which model each uses is chosen in the platform
# console (AI), not here. https://console.anthropic.com
# ANTHROPIC_API_KEY=

# --------------------------------------------------------------- Domains
# Vercel env vars only. With these set, connecting a church's own domain in the
# platform console also adds it to this Vercel project; without them the
# console connects it and says to add it in Vercel by hand.
#
# VERCEL_API_TOKEN: Vercel -> Account Settings -> Tokens, scoped to the team
# that owns the project. VERCEL_PROJECT_ID: Project -> Settings -> General.
# VERCEL_TEAM_ID: only when the project belongs to a team.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# ------------------------------------------------------------------- MCP
# Vercel env vars only, never read by Vite. They govern /api/mcp, which serves
# the church's records to Claude as a Model Context Protocol connector.
#
# Each church issues its own connector link from Settings > Claude connector,
# and chooses there whether it may write. Nothing needs setting here for that.
#
# MCP_TOKEN is the old single-church door, kept so an existing connector keeps
# working through the move: it opens MCP_CHURCH_ID (or VITE_DEFAULT_CHURCH).
# It reads with the Admin SDK, so anyone holding it holds every record that
# church keeps. Leave unset unless you need it.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# MCP_TOKEN=
# MCP_CHURCH_ID=

# Writing, for MCP_TOKEN only. Per-church links carry their own setting.
# MCP_WRITE_TOOLS=false

# Card payments, through PayMongo (lib/platform/payments.js). Without the keys
# the "Pay by card" section in a church's Apps & plan does not show.
#   Dashboard -> Developers -> API keys: the secret key stays on the server; the
#   public key is the browser's and may be seen.
#   Dashboard -> Developers -> Webhooks: add https://<your domain>/api/platform
#   with the subscription.* events; the secret it shows once goes here.
# Use the sk_test_/pk_test_ pair until real payments are wanted.
# PAYMONGO_SECRET_KEY=sk_test_...
# VITE_PAYMONGO_PUBLIC_KEY=pk_test_...
# PAYMONGO_WEBHOOK_SECRET=whsk_...
